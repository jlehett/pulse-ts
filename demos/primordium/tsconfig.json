{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@pulse-ts/core": ["../../packages/core/src"],
            "@pulse-ts/three": ["../../packages/three/src"]
        }
    },
    "include": ["src"]
}
